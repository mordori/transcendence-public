# Copy this file to ".env" before running Prisma locally:
#
#   cp .env.example .env
#
# Then replace YOUR_LOCAL_DATABASE_PASSWORD with the password
# used by your own local PostgreSQL Docker container.
#
# Do not commit the real ".env" file.

# at backend directory
# npx prisma validate --schema=prisma/schema.prisma

DATABASE_URL="postgresql://game_admin:YOUR_LOCAL_DATABASE_PASSWORD@localhost:5432/game_db?schema=public"
